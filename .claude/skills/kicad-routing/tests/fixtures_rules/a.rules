(rules PCB "My Board v2"
  (layer_rule F.Cu
    (active on)
    (preferred_direction vertical)
    (preferred_direction_trace_cost 1.00)
    (against_preferred_direction_trace_cost 2.00)
  )
  (layer_rule GND
    (active off)
  )
  (layer_rule POWER
    (active off)
  )
  (layer_rule B.Cu
    (active on)
    (preferred_direction horizontal)
    (preferred_direction_trace_cost 1.00)
    (against_preferred_direction_trace_cost 2.00)
  )
  (autoroute_settings
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 150)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 1)
  )
)

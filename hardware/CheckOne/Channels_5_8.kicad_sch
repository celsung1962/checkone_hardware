25 0.9525 0.9525) (stroke (width 0.254) (type solid) (color 72 72 200 1)) (fill (type none)) (effects (font (size 2.0 2.0) (bold yes) (color 0 0 194 1)) (justify top)) (uuid "3b2984d5-0757-5ff3-b897-0d7b28f36e1d")) (text_box "CH6" (exclude_from_sim no) (at 71.12 17.78 0) (size 17.78 6.35) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0.254) (type solid) (color 72 72 200 1)) (fill (type none)) (effects (font (size 2.0 2.0) (bold yes) (color 0 0 194 1)) (justify top)) (uuid "4565e9cd-ca8d-5c51-aa99-e1b9052796f6")) (text_box "CH7" (exclude_from_sim no) (at 127.0 17.78 0) (size 17.78 6.35) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0.254) (type solid) (color 72 72 200 1)) (fill (type none)) (effects (font (size 2.0 2.0) (bold yes) (color 0 0 194 1)) (justify top)) (uuid "d788f310-c404-5417-86c9-4f355e90c4fd")) (text_box "CH8" (exclude_from_sim no) (at 182.88000000000002 17.78 0) (size 17.78 6.35) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0.254) (type solid) (color 72 72 200 1)) (fill (type none)) (effects (font (size 2.0 2.0) (bold yes) (color 0 0 194 1)) (justify top)) (uuid "2a4698d4-ef85-516b-a371-1ce4e4692635")) (text_box "Loop input (description 5.2): sensor outputs are isolated, Iin -> R1n0 120 ohm 0.1 % 25 ppm -> GND, Iout = GND. 2.40 V at 20 mA, 2.52 V at 21 mA; ADS1115 +-4.096 V: 1.04 uA per count, readable to ~27.5 mA (calc 1). SMAJ5.0A clamps a +24 V wiring error at 6.4-7.4 V until the channel PTC trips.\nR1n1 4.7 k (rev 1.1, review item 5; v1 1 k): +24 V on Iin pushes 0.6-0.8 mA into +3.3VA through the BAT54S instead of 2.8-3.8 mA, which the XC6206 cannot sink; filter 4.7 k / 10 nF = 3.4 kHz; gain error 0.11 % from the ADS1115 input impedance, removed by the per-channel calibration (calc/checkone_budget.py item 3).\nTerminal pins: 1 +24, 2 GND, 3 Iin, 4 Iout (= GND), same on all eight (D8). Layout: 100 nF at the terminal pins; short shunt return to GND." (exclude_from_sim no) (at 15.24 160.02 0) (size 157.48 33.02) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type solid) (color 204 102 0 1)) (fill (type none)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "53844d88-164e-52e3-b47f-00a40da1419f")) (label "CH5_OUT" (at 43.18 53.975 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "b7e63388-729c-5b5b-b532-dcd4c5dbb23f")) (label "CH5_IIN" (at 40.64 73.025 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "d8e8f989-a2c9-583a-bfac-6c674826aab0")) (label "CH5_AIN" (at 60.96 92.71 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "a2a1df65-5c39-5630-889b-e452e7560ebb")) (label "CH6_OUT" (at 99.06 53.975 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "01b6cbdd-3d8b-5f15-a1a5-b8f8db70d52f")) (label "CH6_IIN" (at 96.52 73.025 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "0e5efdd4-aa2e-55fb-b050-2bfa367a0166")) (label "CH6_AIN" (at 116.84 92.71 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "a9a1490b-72f8-5e07-9f8b-1758aefc5ec8")) (label "CH7_OUT" (at 154.94 53.975 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "346bd3c5-9205-5bfe-8289-27361ed5d66b")) (label "CH7_IIN" (at 152.4 73.025 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "a1a044b6-b01f-5aaa-a63b-5e3cf7d4c7ce")) (label "CH7_AIN" (at 172.72 92.71 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "f8ab84b0-7e0b-5938-bfa7-669b3d1c6a01")) (label "CH8_OUT" (at 210.82 53.975 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "945fc9f3-da6a-5727-923f-fc840efc8fb9")) (label "CH8_IIN" (at 208.28 73.025 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "c12892f
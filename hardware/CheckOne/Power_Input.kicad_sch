525) (stroke (width 0.254) (type solid) (color 72 72 200 1)) (fill (type none)) (effects (font (size 2.0 2.0) (bold yes) (color 0 0 194 1)) (justify top)) (uuid "00f9cf81-35d9-5fb6-b53b-14946e7f5698")) (label "SS_GATE" (at 113.03 71.12 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "9a9472b8-eb58-5e2d-ba95-b16fc54d65a6")) (label "SS_CGD" (at 124.46 92.71 90) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4026d169-88a7-51b5-a4d4-86ad01b54946")) (text_box "Pi filter 68 uH (about 41 Hz)" (exclude_from_sim no) (at 154.94 22.86 0) (size 60.91 6.35) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0.254) (type solid) (color 72 72 200 1)) (fill (type none)) (effects (font (size 2.0 2.0) (bold yes) (color 0 0 194 1)) (justify top)) (uuid "ef44e2a3-8a10-50da-acb3-68c5dcb7f27e")) (label "V24_D" (at 146.05 71.12 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d26d60c9-11c6-5ae5-8628-0560f9621161")) (text_box "Input chain per description 5.1 (S. Zimath, v1): PTC 1.6 A -> SMBJ24A (VBR 26.7-29.5 V) -> SS34 reverse-polarity diode -> 24 V LED -> soft start -> pi filter. Supply 24 V +-5 %, 25.2 V max: above it the SMBJ24A conducts (DS 9).\nSoft start (hot plug, owner meeting 2026-11-16): R2 4.7 k / R3 10 k hold VGS at -7.7 V (24 V) and -12.4 V at the TVS clamp, inside the AO4485 +-20 V; C2 220 uF G-S (+ on the source) keeps the MOSFET off while the plug settles, ~0.2 s delay; C3 + C4 (2 uF) with R4 1 k set the ~20 ms ramp, 1-1.8 A peak into ~1.3 mF (ngspice, DS 5.1 / 9; netlists not in the hand-over, G-1). R4 is essential: without it the cable ringing couples to the gate.\nPi filter: 2 x (220 uF + 1 uF) around L1 68 uH (FCH1040, 4.1 mm pads of v1, S. Zimath 2026-11-16), corner ~41 Hz; drop ~0.16 V." (exclude_from_sim no) (at 15.24 142.24 0) (size 154.94 25.4) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type solid) (color 204 102 0 1)) (fill (type none)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2e301dae-232f-5d04-8d30-fa30706610c7")) (text_box "Layout (v1 LEIA-ME 3): D1 at the DC jack; between D2 and Q1 only C1; copper area on the Q1 drain." (exclude_from_sim no) (at 15.24 170.18 0) (size 154.94 6.35) (margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type solid) (color 0 0 0 1)) (fill (type none)) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "81eaa1ea-89e0-53e6-bfd6-bb9be719fad7")) (wire (pts (xy 33.02 63.5) (xy 35.56 63.5)) (stroke (width 0) (type default)) (uuid "6912768c-e654-56ff-9f66-d6c5c8222d7e")) (wire (pts (xy 33.02 66.04) (xy 35.56 66.04)) (stroke (width 0) (type default)) (uuid "8fb2950f-816e-5be5-8587-ca15347c1356")) (wire (pts (xy 35.56 63.5) (xy 35.56 66.04)) (stroke (width 0) (type default)) (uuid "f1e10014-79e8-54ba-acae-3cc5af9042d0")) (wire (pts (xy 33.02 60.96) (xy 41.91 60.96)) (stroke (width 0) (type default)) (uuid "2783e8d1-babb-5d19-b6f4-e0d9e4bbe2eb")) (wire (pts (xy 49.53 60.96) (xy 58.42 60.96)) (stroke (width 0) (type default)) (uuid "5ffbdb7b-48f7-5475-9a37-2debf9d30b89")) (wire (pts (xy 58.42 60.96) (xy 58.42 63.5)) (stroke (width 0) (type default)) (uuid "287f2927-431e-573a-a1af-8190ef64066c")) (wire (pts (xy 58.42 60.96) (xy 67.31 60.96)) (stroke (width 0) (type default)) (uuid "69a814a6-adcb-5962-9f42-be461eed7493")) (wire (pts (xy 74.93 60.96) (xy 83.82 60.96)) (stroke (width 0) (type default)) (uuid "8e591f1a-83bf-505f-98fd-b07d8a414727")) (wire (pts (xy 83.82 60.96) (xy 91.44 60.96)) (stroke (width 0) (type default)) (uuid "e4fe5ef1-c708-5580-b63b-e721f4fdc1f7")) (wire (pts (xy 91.44 60.96) (xy 101.6 60.96)) (stroke (width 0) (type default)) (uuid "723b5047-7c6c-5253-a515-842ea90f12d8")) (wire (pts (xy 101.6 60.96) (xy 111.76 60.96)) (stroke (width 0) (type default)) (uuid "6df2eadd-15b8-5848-83b1-0e9cfb59ca61")) (wire (pts (xy 111.76 60.96) (xy 121.92 60.96)) (stroke (width 0) (type default)) (uuid "f5d2d85e-0c36-5b1a-81dd-bc6319c